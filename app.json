{
  "expo": {
    "name": "role-sync-app",
    "slug": "role-sync-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-blanco.png",
    "scheme": "rolesyncapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo-blanco.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1c1c1c",
        "foregroundImage": "./assets/images/logo-blanco.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.rolesyncapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.ico",
      "bundler": "metro"
    },
    "splash": {
      "image": "./assets/images/logo-blanco.png",
      "resizeMode": "contain",
      "backgroundColor": "#1c1c1c"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1c1c1c",
          "image": "./assets/images/logo-negro.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "26.1.10909125"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
